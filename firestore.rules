rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNGSI PEMBANTU
    // ============================================================

    // Cek apakah user sudah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Ambil workspaceId dari profile user
    function getWorkspaceId(uid) {
      return get(/databases/$(database)/documents/teacher_profiles/$(uid)).data.workspaceId;
    }

    // Cek apakah dokumen memiliki workspaceId yang sama dengan user
    function hasSameWorkspace(workspaceId) {
      return resource.data.workspaceId == workspaceId;
    }

    // Cek apakah user adalah OWNER dari workspace
    function isOwner(workspaceId) {
      let workspace = get(/databases/$(database)/documents/workspaces/$(workspaceId));
      return workspace != null && workspace.data.ownerUid == request.auth.uid;
    }

    // Cek apakah user adalah ADMIN atau OWNER
    function isAdminOrOwner(workspaceId) {
      let profile = get(/databases/$(database)/documents/teacher_profiles/$(request.auth.uid));
      return profile != null &&
        (profile.data.role == 'OWNER' || profile.data.role == 'ADMIN') &&
        profile.data.workspaceId == workspaceId;
    }

    // Cek apakah user adalah wali kelas dari kelas ini (untuk fitur khusus
    // wali kelas seperti Kas Kelas)
    function isHomeroomOf(className) {
      let profile = get(/databases/$(database)/documents/teacher_profiles/$(request.auth.uid));
      return profile != null && profile.data.homeroomClassName == className;
    }

    // Audit T1/T2 — dipakai teacher_profiles.allow create & allow update
    // supaya validasi role yang boleh diklaim sendiri konsisten di kedua
    // jalur (profil baru lewat create, ATAU profil kosong yang di-update
    // pertama kali saat join — dua-duanya jalur nyata di app). Role tidak
    // pernah dipercaya dari body request begitu saja:
    // - null: belum gabung workspace apa pun, selalu boleh.
    // - TEACHER: workspace tujuan harus SEDANG membuka invite code yang
    //   belum kedaluwarsa (dicek ke dokumen workspaces sungguhan) — tanpa
    //   ini, siapa pun bisa "gabung" ke workspace mana pun cuma dengan
    //   menebak/tahu ID-nya (audit T2).
    // - OWNER: workspace tujuan harus benar dimiliki uid ini.
    // - ADMIN: tidak pernah bisa diklaim sendiri — belum ada alur produk
    //   yang menghasilkannya (audit T1).
    function canClaimRoleForWorkspace(role, workspaceId) {
      return role == null ||
        (role == 'TEACHER' &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.inviteCodeExpiresAt > request.time.toMillis()) ||
        (role == 'OWNER' &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid);
    }

    // --- Siswa (Student Companion) ---
    // Siswa tidak punya teacher_profiles, jadi getWorkspaceId(uid) di atas
    // akan gagal (get() pada dokumen yang tidak ada = deny, bukan error) —
    // itu sudah cukup untuk mengunci siswa dari semua koleksi guru-only di
    // bawah tanpa perubahan apa pun. Fungsi-fungsi ini khusus dipakai di
    // koleksi yang MEMANG perlu dibuka untuk siswa (lihat Student Companion
    // di visi produk: jadwal, tugas, nilai, presensi).
    function isStudentAuthed() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/student_profiles/$(request.auth.uid));
    }

    function studentProfileData() {
      return get(/databases/$(database)/documents/student_profiles/$(request.auth.uid)).data;
    }

    function isStudentInWorkspace(workspaceId) {
      return isStudentAuthed() && studentProfileData().workspaceId == workspaceId;
    }

    function isStudentInClass(workspaceId, className) {
      return isStudentInWorkspace(workspaceId) && studentProfileData().className == className;
    }

    // workspaceId WAJIB ikut diperiksa, bukan hanya studentId. Tanpa itu,
    // siswa di workspace lain yang kebetulan punya studentId sama bisa
    // membaca data milik siswa di workspace ini. studentId memang id acak
    // Firestore sehingga tabrakan sangat tidak mungkin — tapi keamanan
    // yang bersandar pada "id-nya sulit ditebak" bukan keamanan.
    function isOwnStudentData(workspaceId, studentId) {
      return isStudentInWorkspace(workspaceId) && studentProfileData().studentId == studentId;
    }

    // ============================================================
    // KOLEKSI: teacher_profiles
    // ============================================================
    match /teacher_profiles/{userId} {
      // User bisa membaca profilnya sendiri
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Membuat profil sendiri — langkah pertama daftar workspace baru
      // ATAU gabung lewat kode undangan (lihat workspaceService.
      // createIndividualWorkspace/createSchoolWorkspace/
      // joinWorkspaceByCode, semuanya menulis dokumen ini pertama kali).
      //
      // role TIDAK dipercaya begitu saja dari body request (celah audit
      // T1 — sebelumnya field ini bisa ditulis bebas lewat allow write
      // yang cuma mengunci workspaceId) — validasinya lewat
      // canClaimRoleForWorkspace() di atas, supaya create & update
      // (lihat di bawah) selalu konsisten.
      //
      // homeroomClassName tidak boleh langsung diisi saat membuat profil
      // baru — itu keputusan terpisah dari sekadar bergabung workspace
      // (lihat allow update di bawah).
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        canClaimRoleForWorkspace(request.resource.data.get('role', null), request.resource.data.get('workspaceId', null)) &&
        request.resource.data.get('homeroomClassName', null) == null;

      // Update profil sendiri. Tiga field ini sengaja dibatasi supaya
      // guru tidak bisa menaikkan hak aksesnya sendiri (audit T1):
      // - workspaceId & role: sekali terisi bersamaan (dari kosong ke
      //   suatu workspace, saat daftar ATAU gabung lewat kode undangan
      //   — lihat assignTeacherToWorkspace), keduanya terkunci. Kalau
      //   profil MASIH kosong (workspaceId lama null), boleh diisi
      //   sekali lewat validasi canClaimRoleForWorkspace() yang sama
      //   persis dengan allow create — celah audit T2 sebelumnya cuma
      //   ditutup di allow create, padahal profil kosong yang di-update
      //   (bukan dibuat baru) adalah jalur yang sama nyatanya.
      // - homeroomClassName: hanya boleh diubah kalau role SAAT INI
      //   (dari data lama, sebelum write ini) sudah OWNER/ADMIN — guru
      //   TEACHER biasa tidak bisa menobatkan diri sendiri jadi wali
      //   kelas mana pun. Itu pintu masuk ke student_notes/
      //   class_fund_transactions/class_inventory kelas itu lewat
      //   isHomeroomOf() — persis jalur eksploitasi yang ditemukan di
      //   audit T1.
      //
      // .get(key, default) dipakai di sini (bukan dot-access biasa)
      // untuk field opsional (role, homeroomClassName) — dot-access
      // langsung ke field yang tidak ada di kedua sisi (dokumen lama
      // maupun baru) meledak jadi evaluation error di rules, bukan
      // sekadar undefined seperti JS.
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        (
          (request.resource.data.workspaceId == resource.data.workspaceId &&
           request.resource.data.get('role', null) == resource.data.get('role', null)) ||
          (resource.data.workspaceId == null &&
           canClaimRoleForWorkspace(request.resource.data.get('role', null), request.resource.data.get('workspaceId', null)))
        ) &&
        (request.resource.data.get('homeroomClassName', null) == resource.data.get('homeroomClassName', null) ||
         resource.data.get('role', null) in ['OWNER', 'ADMIN']);

      // OWNER bisa membaca semua profil di workspace-nya (untuk manajemen).
      // exists() dicek dulu sebelum getWorkspaceId() (yang men-dot-access
      // .data pada dokumen profil milik requester sendiri) — tanpa ini,
      // pengguna yang BELUM PERNAH punya teacher_profiles sama sekali
      // (mis. guru baru di tengah alur join-by-code, sebelum profilnya
      // sendiri tertulis) memicu evaluation error saat rule ini dievaluasi
      // untuk operasi list/count, bukan sekadar ditolak dengan bersih.
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/teacher_profiles/$(request.auth.uid)) &&
        isAdminOrOwner(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: workspaces
    // ============================================================
    match /workspaces/{workspaceId} {
      // Siapa pun bisa membuat workspace (dengan validasi)
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid;

      // Owner bisa membaca workspace sendiri, teacher bisa membaca workspace-nya
      allow read: if isAuthenticated() &&
        (resource.data.ownerUid == request.auth.uid ||
         getWorkspaceId(request.auth.uid) == workspaceId);

      // Audit T2: guru BARU (belum tergabung workspace mana pun) perlu
      // membaca SATU dokumen workspace tertentu untuk pratinjau saat
      // gabung lewat kode undangan (lihat workspace_invites di bawah —
      // itu satu-satunya cara tahu workspaceId ini). Sengaja `allow get`
      // saja (BUKAN `allow read`), supaya list/query ke seluruh
      // collection tetap tertutup total — cuma bisa diakses satu-satu
      // kalau sudah tahu persis ID-nya, sama seperti keamanan
      // student_login_codes.
      //
      // Syaratnya cuma "workspace ini pernah mengaktifkan invite code"
      // (field inviteCode ada), BUKAN "invite-nya masih berlaku" — kalau
      // dicek kedaluwarsa di sini, guru dengan kode basi akan lihat
      // error "permission-denied" yang membingungkan alih-alih pesan
      // "kode sudah kedaluwarsa" yang sudah ada di workspaceService.
      // Keabsahan SUNGGUHAN (kode belum berubah & belum kedaluwarsa)
      // ditegakkan di titik yang benar-benar menulis akses: allow create
      // di teacher_profiles (lihat komentar role=='TEACHER' di atas).
      allow get: if isAuthenticated() && resource.data.inviteCode != null;

      // Owner bisa mengupdate workspace-nya — TAPI field plan/classLimit/
      // seatLimit/planExpiresAt DIKUNCI dari client sama sekali. Field-
      // field itu cuma boleh berubah lewat webhook pembayaran (Admin SDK,
      // bypass rules) setelah verifikasi signature Midtrans — kalau tidak
      // dikunci di sini, owner bisa upgrade paketnya sendiri gratis lewat
      // DevTools/Firestore SDK langsung.
      allow update: if isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['plan', 'classLimit', 'seatLimit', 'planExpiresAt']);

      // 🔴 DILARANG: Tidak boleh menghapus workspace
      allow delete: if false;
    }

    // ============================================================
    // KOLEKSI: workspace_invites (jembatan kode undangan -> workspaceId)
    // Dokumen ID = inviteCode itu sendiri, isinya cuma {workspaceId,
    // expiresAt}. Perbaikan audit T2 — sebelumnya guru baru mencari
    // workspace lewat query where(inviteCode==...) langsung ke
    // collection workspaces, yang MUSTAHIL dipenuhi allow read di sana
    // (guru baru bukan owner & belum punya workspaceId). Dipisah ke
    // collection sendiri persis pola student_login_codes: allow get
    // (ambil satu dokumen kalau sudah tahu kodenya) TAPI BUKAN allow
    // list — supaya tidak ada yang bisa mengintip/enumerasi seluruh kode
    // undangan aktif. Keamanan gabung-workspace bergantung pada kode
    // acak & rahasia, sama seperti student_login_codes, BUKAN pada
    // workspace scoping (guru baru memang belum punya workspaceId).
    // ============================================================
    match /workspace_invites/{code} {
      allow get: if isAuthenticated();
      allow list: if false;

      // Cuma owner workspace terkait yang boleh membuat/mengganti
      // jembatan kode — dicek ke dokumen workspaces sungguhan, bukan
      // dipercaya dari body request, supaya tidak ada yang membuat
      // "kode undangan" palsu menunjuk ke workspace milik orang lain.
      allow create: if isAuthenticated() &&
        get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.ownerUid == request.auth.uid;

      allow update, delete: if isAuthenticated() &&
        get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.ownerUid == request.auth.uid;
    }

    // ============================================================
    // KOLEKSI: payments (riwayat transaksi Midtrans)
    // ============================================================
    match /payments/{orderId} {
      // Hanya owner workspace terkait yang boleh melihat riwayat
      // pembayarannya (informasi billing, bukan untuk seluruh guru).
      allow read: if isAuthenticated() && isOwner(resource.data.workspaceId);

      // Tidak ada write dari client sama sekali — dokumen ini hanya
      // ditulis lewat Admin SDK (route pembuatan transaksi & webhook
      // pembayaran), supaya status pembayaran tidak bisa dipalsukan.
      allow write: if false;
    }

    // ============================================================
    // KOLEKSI: students
    // ============================================================
    match /students/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: schedules
    // ============================================================
    match /schedules/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      // Siswa boleh baca jadwal kelasnya sendiri (Student Companion).
      allow read: if isStudentInClass(resource.data.workspaceId, resource.data.className);

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: journals
    // ============================================================
    match /journals/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: session_skip_reasons — alasan guru tidak sempat mengajar
    // sesi terjadwal ("Penyesuaian Workflow Jadwal — Final" #3). Internal
    // guru, tidak pernah dibaca siswa (beda dari journals/attendances).
    // ============================================================
    match /session_skip_reasons/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: academic_years — batas tanggal Tahun Ajaran (Data Lifecycle).
    // Murni metadata tanggal, tidak pernah menyentuh/mengunci koleksi lain.
    // ============================================================
    match /academic_years/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: attendances
    // ============================================================
    match /attendances/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      // Siswa boleh baca riwayat presensi kelasnya (Student Companion).
      // Satu dokumen presensi berisi status SEMUA siswa sekelas dalam satu
      // sesi (bukan per-siswa) — siswa jadi ikut melihat status teman
      // sekelasnya, bukan cuma dirinya sendiri. Diterima sebagai trade-off
      // yang sama seperti Kas Kelas/Inventaris (transparan satu kelas),
      // karena status hadir bukan data sensitif.
      allow read: if isStudentInClass(resource.data.workspaceId, resource.data.className);

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: grades
    // ============================================================
    match /grades/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      // Siswa cuma boleh baca nilainya sendiri, bukan nilai sekelas.
      allow read: if isOwnStudentData(resource.data.workspaceId, resource.data.studentId);

      // `get` pada dokumen yang BELUM ada: resource bernilai null, sehingga
      // kedua aturan read di atas ikut gagal (membaca resource.data dari
      // null itu error) dan Firestore menolaknya. Padahal justru itu yang
      // perlu diperiksa siswa TEPAT SEBELUM mengumpulkan — "apakah aku
      // sudah pernah mengirim, dan apakah sudah dinilai?" — supaya
      // keputusannya berdasar data server, bukan layar yang mungkin sudah
      // basi. Tanpa aturan ini, pengumpulan PERTAMA setiap siswa gagal
      // dengan permission-denied.
      //
      // Bukan pelonggaran: dokumen yang belum ada tidak memuat data siapa
      // pun, jadi tidak ada yang bisa bocor — dan tetap dipersempit ke
      // dokumen yang ID-nya memang milik siswa itu sendiri (ID submission
      // selalu "{assignmentId}_{studentId}", lihat submissionRepository).
      allow get: if resource == null &&
        isStudentAuthed() &&
        docId.matches('.*_' + studentProfileData().studentId);

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: grade_columns
    // ============================================================
    match /grade_columns/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      // Siswa perlu baca kolom nilai kelasnya supaya nilai (di collection
      // grades) bisa ditampilkan dengan judul komponennya, bukan cuma id.
      allow read: if isStudentInClass(resource.data.workspaceId, resource.data.className);

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: assignments
    // ============================================================
    match /assignments/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      // Siswa boleh baca daftar tugas kelasnya (Student Companion).
      allow read: if isStudentInClass(resource.data.workspaceId, resource.data.className);

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: announcements (Pengumuman guru -> siswa sekelas)
    // ============================================================
    match /announcements/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      // Siswa boleh baca pengumuman kelasnya — ini justru tujuan fiturnya.
      // Tetap dibatasi per kelas supaya pengumuman kelas lain tidak ikut
      // terbaca.
      allow read: if isStudentInClass(resource.data.workspaceId, resource.data.className);

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: submissions
    // Guru baca/tulis semua submission di workspace-nya (untuk menilai).
    // Siswa cuma boleh baca & tulis submission miliknya sendiri — tidak
    // bisa melihat atau menulis submission siswa lain, dan tidak bisa
    // mengubah field `status`/nilai (itu hak guru lewat gradeSubmission,
    // yang menulis ke collection grades, bukan ke submissions.status
    // langsung dari client siswa).
    // ============================================================
    match /submissions/{docId} {
      // Apakah dokumen ini memuat pekerjaan yang BENAR-BENAR dikirim
      // siswa — bukan sekadar dokumen yang pernah disentuh guru saat
      // menilai/memberi catatan. Bedanya menentukan siapa yang masih boleh
      // menulis (lihat allow update di bawah).
      function hasStudentWork(data) {
        return data.get('submittedAt', null) != null ||
          data.get('textAnswer', '') != '' ||
          data.get('fileUrl', null) != null ||
          data.get('attachments', []).size() > 0;
      }

      // Catatan guru adalah milik guru: siswa boleh MEMBACANYA (dokumen ini
      // memang miliknya) tapi tidak boleh mengubah atau menghapusnya lewat
      // pengumpulan ulang.
      function keepsTeacherFeedback() {
        return request.resource.data.get('feedback', '') == resource.data.get('feedback', '');
      }

      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow read: if isOwnStudentData(resource.data.workspaceId, resource.data.studentId);

      // `get` pada dokumen yang BELUM ada: resource bernilai null, sehingga
      // kedua aturan read di atas ikut gagal (membaca resource.data dari
      // null itu error) dan Firestore menolaknya. Padahal justru itu yang
      // perlu diperiksa siswa TEPAT SEBELUM mengumpulkan — "apakah aku
      // sudah pernah mengirim, dan apakah sudah dinilai?" — supaya
      // keputusannya berdasar data server, bukan layar yang mungkin sudah
      // basi. Tanpa aturan ini, pengumpulan PERTAMA setiap siswa gagal
      // dengan permission-denied.
      //
      // Bukan pelonggaran: dokumen yang belum ada tidak memuat data siapa
      // pun, jadi tidak ada yang bisa bocor — dan tetap dipersempit ke
      // dokumen yang ID-nya memang milik siswa itu sendiri (ID submission
      // selalu "{assignmentId}_{studentId}", lihat submissionRepository).
      allow get: if resource == null &&
        isStudentAuthed() &&
        docId.matches('.*_' + studentProfileData().studentId);

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow create: if isOwnStudentData(request.resource.data.workspaceId, request.resource.data.studentId) &&
        request.resource.data.status == 'menunggu_penilaian' &&
        request.resource.data.get('feedback', '') == '';

      allow update: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      // Siswa boleh memperbaiki pengumpulannya selama belum dinilai.
      //
      // `!hasStudentWork(resource.data)` BUKAN pelonggaran, justru
      // perbaikan bug: dokumen yang ditandai 'dinilai' padahal siswanya
      // belum pernah mengirim apa pun (dulu terjadi setiap kali guru
      // mengisi nilai untuk siswa yang belum mengumpulkan) mengunci siswa
      // itu dari mengumpulkan SELAMANYA, tanpa pesan apa pun. Yang tetap
      // terkunci rapat adalah yang memang seharusnya: pekerjaan yang sudah
      // dikirim DAN sudah dinilai gurunya.
      allow update: if isOwnStudentData(resource.data.workspaceId, resource.data.studentId) &&
        isOwnStudentData(request.resource.data.workspaceId, request.resource.data.studentId) &&
        request.resource.data.status == 'menunggu_penilaian' &&
        (resource.data.status != 'dinilai' || !hasStudentWork(resource.data)) &&
        keepsTeacherFeedback();

      allow delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: student_login_codes (klaim akun Student Companion)
    // Dokumen ID = accessCode itu sendiri, isinya cuma {studentId,
    // workspaceId}. Sengaja HANYA allow get (ambil satu dokumen kalau
    // sudah tahu kodenya), BUKAN list — supaya tidak ada yang bisa
    // mengintip/enumerasi semua kode siswa. Keamanan alur klaim
    // bergantung pada kode yang acak & rahasia, sama seperti kode
    // kelas di Google Classroom/Kahoot — bukan pada workspace scoping,
    // karena saat klaim siswa belum py profil apa pun.
    // ============================================================
    match /student_login_codes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid);

      allow update, delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));
    }

    // ============================================================
    // KOLEKSI: student_profiles (identitas akun Student Companion)
    // Kebalikan dari teacher_profiles: 1 dokumen per akun siswa, ID
    // dokumen = authUid siswa (bisa anonim). Dibuat sekali saat klaim
    // accessCode lewat studentAuthService.claimAccessCode, lalu jadi
    // sumber kebenaran "siswa ini siapa & kelas mana" untuk semua rule
    // isStudentInClass/isOwnStudentData di atas.
    // ============================================================
    match /student_profiles/{authUid} {
      allow read: if isAuthenticated() && request.auth.uid == authUid;

      // Sekali buat, tidak bisa diubah lagi — identitas siswa terkunci
      // begitu ter-klaim (kalau kode disebar ke device lain, device itu
      // dapat dokumen profilnya sendiri, bukan menimpa yang ini).
      allow create: if isAuthenticated() && request.auth.uid == authUid;
      allow update, delete: if false;
    }

    // ============================================================
    // KOLEKSI: class_fund_transactions (Kas Kelas — khusus wali kelas)
    // ============================================================
    match /class_fund_transactions/{docId} {
      // Seluruh guru di workspace boleh membaca (transparansi kas) — rule
      // ini cuma memeriksa workspace, TIDAK memfilter per kelas, jadi bukan
      // cuma "sekelas" yang bisa lihat (audit T4 — didiskusikan dan
      // dikonfirmasi sebagai perilaku yang memang diinginkan: guru lain di
      // sekolah yang sama boleh melihat data kelas lain). Hanya wali kelas
      // dari kelas itu yang boleh menulis/menghapus.
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid) &&
        isHomeroomOf(request.resource.data.className);

      allow update, delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid)) &&
        isHomeroomOf(resource.data.className);
    }

    // ============================================================
    // KOLEKSI: class_inventory (Inventaris Kelas — khusus wali kelas)
    // ============================================================
    match /class_inventory/{docId} {
      // Seluruh guru di workspace boleh membaca (transparansi barang) —
      // rule ini cuma memeriksa workspace, TIDAK memfilter per kelas (audit
      // T4 — dikonfirmasi sebagai perilaku yang memang diinginkan). Hanya
      // wali kelas dari kelas itu yang boleh menulis/menghapus.
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid));

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid) &&
        isHomeroomOf(request.resource.data.className);

      allow update, delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid)) &&
        isHomeroomOf(resource.data.className);
    }

    // ============================================================
    // KOLEKSI: student_notes (Konseling, Prestasi, Komunikasi Ortu —
    // khusus wali kelas). Berbeda dari Kas Kelas/Inventaris: ini data
    // pribadi siswa, jadi baca DIBATASI ke wali kelas kelas itu atau
    // admin/owner — tidak untuk seluruh guru di workspace.
    // ============================================================
    // CATATAN PENTING: koleksi ini TIDAK PERNAH dibuka untuk siswa, dan
    // tidak boleh dibuka. Prestasi — satu-satunya kategori yang perlu
    // dilihat siswa — sudah dipindah ke koleksi student_achievements di
    // bawah. Menambahkan aturan baca untuk siswa di sini, walau dibatasi
    // category == 'prestasi', berarti satu salah ketik memisahkan siswa
    // dari catatan konselingnya sendiri.
    match /student_notes/{docId} {
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid)) &&
        (isHomeroomOf(resource.data.className) ||
         isAdminOrOwner(getWorkspaceId(request.auth.uid)));

      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid) &&
        isHomeroomOf(request.resource.data.className);

      allow update, delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid)) &&
        isHomeroomOf(resource.data.className);
    }

    // ============================================================
    // KOLEKSI: student_achievements (Prestasi siswa)
    //
    // Kenapa koleksi sendiri, bukan student_notes dengan filter kategori?
    // Karena student_notes juga menyimpan catatan konseling. Kalau siswa
    // diberi akses baca ke sana — sekalipun dibatasi category ==
    // 'prestasi' — maka satu kondisi yang keliru, satu dokumen konseling
    // yang kelupaan diisi category-nya, atau satu kategori sensitif baru
    // di masa depan, langsung berarti kebocoran catatan konseling.
    //
    // Dengan koleksi terpisah, kesalahan apa pun pada aturan di bawah ini
    // secara struktural tidak bisa menyentuh data konseling: koleksi itu
    // tidak punya satu pun aturan yang memberi siswa akses.
    // ============================================================
    match /student_achievements/{docId} {
      // Guru: sama seperti prestasi sebelumnya — wali kelas kelas itu,
      // atau admin/owner workspace.
      allow read: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid)) &&
        (isHomeroomOf(resource.data.className) ||
         isAdminOrOwner(getWorkspaceId(request.auth.uid)));

      // Siswa: HANYA prestasi miliknya sendiri — bukan sekelas.
      allow read: if isOwnStudentData(resource.data.workspaceId, resource.data.studentId);

      // Menulis tetap hak wali kelas; siswa tidak bisa mencatat prestasi
      // untuk dirinya sendiri.
      allow create: if isAuthenticated() &&
        request.resource.data.workspaceId == getWorkspaceId(request.auth.uid) &&
        isHomeroomOf(request.resource.data.className);

      allow update, delete: if isAuthenticated() &&
        hasSameWorkspace(getWorkspaceId(request.auth.uid)) &&
        isHomeroomOf(resource.data.className);
    }
  }
}
