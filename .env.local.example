# Salin file ini ke .env.local lalu isi nilainya. Jangan pernah
# commit .env.local (sudah di-gitignore) — file contoh ini boleh
# di-commit karena tidak berisi kredensial sungguhan.

# --- Firebase client SDK (wajib, lihat README.md) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (wajib untuk route handler, mis. rename kelas,
#     webhook pembayaran) — isi dengan seluruh JSON service account
#     Firebase dalam SATU baris. Hanya di-set di Vercel, tidak perlu di
#     lokal kalau memakai emulator. ---
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# --- Midtrans (pembayaran), lihat docs/PAYMENTS.md ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Catatan: upload lampiran tugas TIDAK butuh env var tambahan apa pun di
# luar Firebase di atas — jalurnya lewat Firebase Storage (client SDK),
# lihat lib/adapters/storageAdapter.ts dan docs/AKTIFKAN-STORAGE.md kalau
# upload belum berfungsi. Opsi "kumpulkan lewat Google Drive" untuk siswa
# memakai link Drive pribadi yang ditempel manual (lib/utils/
# submissionLink.ts) — tidak perlu Service Account atau Google Workspace.
