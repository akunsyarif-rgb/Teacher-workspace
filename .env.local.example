# Salin file ini ke .env.local lalu isi nilainya. Jangan pernah
# commit .env.local (sudah di-gitignore) — file contoh ini boleh
# di-commit karena tidak berisi kredensial sungguhan.

# --- Firebase client SDK (wajib, lihat README.md) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (wajib untuk route handler, mis. rename kelas,
#     webhook pembayaran) — isi dengan seluruh JSON service account
#     Firebase dalam SATU baris. Hanya di-set di Vercel, tidak perlu di
#     lokal kalau memakai emulator. ---
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# --- Midtrans (pembayaran), lihat docs/PAYMENTS.md ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Google Drive (Service Account) — jalur upload alternatif di app/api/
#     upload, lihat lib/adapters/googleDriveAdapter.ts. Opsional: kalau
#     tidak di-set, tombol "Upload ke Google Drive" akan gagal dengan
#     pesan yang jelas, tapi jalur Firebase Storage tetap berfungsi normal. ---
#
# 1. Buat/gunakan Service Account di Google Cloud Console (project boleh
#    sama dengan project Firebase, atau project terpisah).
# 2. Aktifkan "Google Drive API" untuk project itu.
# 3. Buat key JSON untuk Service Account tsb, ambil dua field ini darinya:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key dari file JSON APA ADANYA (termasuk header/footer
# -----BEGIN PRIVATE KEY-----). Kalau ditempel sebagai satu baris di
# Vercel, baris barunya harus literal "\n" — kode di
# googleDriveAdapter.ts sudah menangani konversi \n -> baris baru asli.
GOOGLE_PRIVATE_KEY=
# 4. PENTING: buat folder untuk lampiran ini di dalam SHARED DRIVE (dulu
#    "Team Drive"), BUKAN folder biasa di "My Drive" siapa pun — Google
#    Cloud menonaktifkan kuota penyimpanan pribadi Service Account sejak
#    2022-an, jadi upload ke folder My Drive akan gagal dengan error
#    "Service Accounts do not have storage quota" walau kredensial &
#    izinnya benar. Shared Drive perlu paket Google Workspace (bukan akun
#    Google gratis) — kalau sekolah belum punya, jalur Firebase Storage
#    di atas tetap jadi satu-satunya opsi yang berfungsi.
# 5. Tambahkan Service Account (GOOGLE_SERVICE_ACCOUNT_EMAIL di atas)
#    sebagai anggota Shared Drive tsb dengan peran "Content manager" atau
#    lebih tinggi — tanpa ini, Service Account tidak akan bisa menulis
#    file ke situ walau kredensialnya benar.
# 6. Buat folder lampiran di dalam Shared Drive itu, lalu ambil ID-nya
#    dari URL folder di browser:
#    https://drive.google.com/drive/folders/<ID_FOLDER_INI>
GOOGLE_DRIVE_FOLDER_ID=
